<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ComboBox?>

<BorderPane style="-fx-background-color: #F3F7FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hospital.practicantes.controllers.PracticanteController">

    <top>
        <VBox spacing="4.0" style="-fx-padding: 24 24 12 24;">
            <Label text="Gestion de Practicantes"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E3A5F;" />
            <Label text="Registro del estudiante"
                   wrapText="true"
                   style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" />
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

            <!-- Header tabla -->
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Listado de practicantes registrados"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E3A5F;" />
                    <Label text="Haz clic en una fila para editar"
                           style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtBuscar"
                           promptText="🔍  Buscar por nombre o documento..."
                           prefWidth="260"
                           style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #D1D5DB; -fx-padding: 8 12;
                                  -fx-font-size: 13px;" />
            </HBox>

            <!-- Tabla -->
            <TableView fx:id="tablaPracticantes" prefHeight="400"
                       style="-fx-background-radius: 10; -fx-border-color: #E5E7EB;
                              -fx-border-radius: 10;">
                <columns>
                    <TableColumn fx:id="colId"          text="ID"           prefWidth="45" />
                    <TableColumn fx:id="colNombre"      text="Nombre"       prefWidth="155" />
                    <TableColumn fx:id="colDocumento"   text="Documento"    prefWidth="110" />
                    <TableColumn fx:id="colUniversidad" text="Universidad"  prefWidth="155" />
                    <TableColumn fx:id="colPrograma"    text="Programa"     prefWidth="125" />
                    <TableColumn fx:id="colDocente"     text="Docente"      prefWidth="125" />
                    <TableColumn fx:id="colEstado"      text="Estado"       prefWidth="110" />
                </columns>
                <placeholder>
                    <Label text="No hay practicantes registrados aun."
                           style="-fx-text-fill: #9CA3AF; -fx-font-size: 13px;" />
                </placeholder>
            </TableView>

        </VBox>
        <BorderPane.margin>
            <Insets bottom="24.0" left="24.0" right="12.0" top="0.0" />
        </BorderPane.margin>
    </center>

    <right>
        <ScrollPane fitToWidth="true" prefWidth="320"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 14;
                             -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                    <!-- Titulo formulario -->
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="lblTituloFormulario" text="Nuevo practicante"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E3A5F;" />
                    </HBox>

                    <!-- Nombre -->
                    <Label text="Nombre completo"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <TextField fx:id="txtNombre" promptText="Ej: Ana Torres"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #D1D5DB; -fx-padding: 9; -fx-font-size: 13px;" />

                    <!-- Documento -->
                    <Label text="Numero de documento"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <TextField fx:id="txtDocumento" promptText="Cedula"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #D1D5DB; -fx-padding: 9; -fx-font-size: 13px;" />

                    <!-- Universidad -->
                    <Label text="Universidad"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <TextField fx:id="txtUniversidad" promptText="Entidad universitaria"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #D1D5DB; -fx-padding: 9; -fx-font-size: 13px;" />

                    <!-- Semestre -->
                    <Label text="Semestre"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <TextField fx:id="txtSemestre" promptText="Ej: 6"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #D1D5DB; -fx-padding: 9; -fx-font-size: 13px;" />

                    <!-- Programa -->
                    <Label text="Programa academico"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <TextField fx:id="txtPrograma" promptText="Medicina, Enfermeria..."
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #D1D5DB; -fx-padding: 9; -fx-font-size: 13px;" />

                    <!-- Docente -->
                    <Label text="Docente responsable"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
                    <TextField fx:id="txtDocente" promptText="Nombre del docente"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #D1D5DB; -fx-padding: 9; -fx-font-size: 13px;" />

                    <!-- Checkboxes -->
                    <HBox spacing="12" style="-fx-padding: 4 0;">
                        <CheckBox fx:id="chkInduccion" text="Induccion realizada"
                                  style="-fx-text-fill: #374151; -fx-font-size: 12px;" />
                        <CheckBox fx:id="chkArl" text="ARL vigente"
                                  style="-fx-text-fill: #374151; -fx-font-size: 12px;" />
                    </HBox>

<!-- Estado -->
<Label text="Estado"
       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #374151;" />
<ComboBox fx:id="cmbEstado" maxWidth="Infinity"
          promptText="Seleccione un estado..."
          style="-fx-background-radius: 8; -fx-border-radius: 8;
                 -fx-border-color: #D1D5DB; -fx-font-size: 13px;" />

                 <HBox spacing="8">
    <Button HBox.hgrow="ALWAYS" maxWidth="Infinity"
            mnemonicParsing="false"
            onAction="#guardarPracticante" text="Guardar"
            style="-fx-background-color: #1A56DB; -fx-text-fill: white;
                   -fx-font-weight: bold; -fx-background-radius: 9;
                   -fx-padding: 11; -fx-font-size: 13px; -fx-cursor: hand;" />
    <Button HBox.hgrow="ALWAYS" maxWidth="Infinity"
            mnemonicParsing="false"
            onAction="#eliminarPracticante" text="Eliminar"
            style="-fx-background-color: #FEF2F2; -fx-text-fill: #DC2626;
                   -fx-font-weight: bold; -fx-background-radius: 9;
                   -fx-padding: 11; -fx-font-size: 13px; -fx-cursor: hand;
                   -fx-border-color: #FECACA; -fx-border-radius: 9;" />
    <Button HBox.hgrow="ALWAYS" maxWidth="Infinity"
            mnemonicParsing="false"
            onAction="#limpiarFormulario" text="Cancelar"
            style="-fx-background-color: #F3F4F6; -fx-text-fill: #374151;
                   -fx-font-weight: bold; -fx-background-radius: 9;
                   -fx-padding: 11; -fx-font-size: 13px; -fx-cursor: hand;" />
</HBox>

                 

                    <!-- Mensaje feedback -->
                    <Label fx:id="lblMensaje" text=""
                           wrapText="true"
                           style="-fx-font-size: 12px; -fx-text-fill: #059669;" />


                    <!-- Info requisitos -->
                    <VBox spacing="6"
                          style="-fx-background-color: #EFF6FF; -fx-background-radius: 10; -fx-padding: 14;">
                        <Label text="📋 Datos requeridos por el hospital"
                               style="-fx-font-weight: bold; -fx-text-fill: #1E3A5F; -fx-font-size: 12px;" />
                        <Label text="✔ Nombre e identificacion nominal"
                               style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
                        <Label text="✔ Universidad, semestre y programa"
                               style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
                        <Label text="✔ Docente acompanante registrado"
                               style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
                        <Label text="✔ Induccion completada y ARL vigente"
                               style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
        <BorderPane.margin>
            <Insets bottom="24.0" left="12.0" right="24.0" top="0.0" />
        </BorderPane.margin>
    </right>

</BorderPane>