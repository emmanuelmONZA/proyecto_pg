<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<ScrollPane fitToWidth="true"
            style="-fx-background-color: #F3F7FA; -fx-background: #F3F7FA;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.hospital.practicantes.controllers.InicioController">

  <content>
    <VBox spacing="20.0" style="-fx-padding: 28; -fx-background-color: #F3F7FA;">

      <!-- HEADER -->
      <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="3">
          <Label text="Bienvenidos al sistemas de monitoreo de estudiantes"
                 style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
          <Label text="Vista general del sistema de practicas — Hospital San Rafael"
                 style="-fx-font-size: 13px; -fx-text-fill: #6B7280;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <VBox alignment="CENTER_RIGHT" spacing="2">
          <Label text="Hola, Administrador"
                 style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1F8A8A;" />
          <Label text="Hoy, lunes 19 mayo 2026"
                 style="-fx-font-size: 11px; -fx-text-fill: #9CA3AF;" />
        </VBox>
      </HBox>

      <!-- TARJETAS DE RESUMEN -->
      <HBox spacing="14.0">

        <!-- Estudiantes activos -->
        <VBox prefWidth="185" spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="👨‍⚕️" style="-fx-font-size: 22px;" />
            <Label text="120"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1F8A8A;" />
          </HBox>
          <Label text="Estudiantes activos"
                 style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" wrapText="true"/>
          <Label text="↑ En este momento"
                 style="-fx-font-size: 11px; -fx-text-fill: #10B981;" />
        </VBox>

        <!-- Docentes activos -->
        <VBox prefWidth="185" spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🎓" style="-fx-font-size: 22px;" />
            <Label text="15"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1F8A8A;" />
          </HBox>
          <Label text="Docentes activos"
                 style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" wrapText="true"/>
          <Label text="24 universidades en convenio"
                 style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" />
        </VBox>

        <!-- Alertas activas -->
        <VBox prefWidth="185" spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #FEE2E2; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="⚠️" style="-fx-font-size: 22px;" />
            <Label text="5"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #DC2626;" />
          </HBox>
          <Label text="Alertas activas"
                 style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" wrapText="true"/>
          <Label text="Requieren atencion inmediata"
                 style="-fx-font-size: 11px; -fx-text-fill: #DC2626;" />
        </VBox>

        <!-- Areas ocupadas -->
        <VBox prefWidth="185" spacing="8"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
          <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🏥" style="-fx-font-size: 22px;" />
            <Label text="8"
                   style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #F59E0B;" />
          </HBox>
          <Label text="Areas ocupadas"
                 style="-fx-font-size: 12px; -fx-text-fill: #6B7280;" wrapText="true"/>
          <Label text="De 12 areas disponibles"
                 style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" />
        </VBox>

      </HBox>

      <GridPane hgap="16" vgap="16">
        <columnConstraints>
          <ColumnConstraints percentWidth="55" />
          <ColumnConstraints percentWidth="45" />
        </columnConstraints>

        <!-- Distribucion por area -->
        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="12"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
          <Label text="Distribución actual por área"
                 style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" />

          <!-- Urgencias -->
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="●" style="-fx-text-fill: #DC2626; -fx-font-size: 14px;" />
            <Label text="Urgencias" prefWidth="140" style="-fx-text-fill: #374151;" />
            <Label text="20 estudiantes" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="20/20" style="-fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-font-size: 12px;" />
          </HBox>
          <!-- Pediatria -->
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="●" style="-fx-text-fill: #1F8A8A; -fx-font-size: 14px;" />
            <Label text="Pediatria" prefWidth="140" style="-fx-text-fill: #374151;" />
            <Label text="18 estudiantes" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="18/25" style="-fx-text-fill: #1F8A8A; -fx-font-weight: bold; -fx-font-size: 12px;" />
          </HBox>
          <!-- UCI -->
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="●" style="-fx-text-fill: #F59E0B; -fx-font-size: 14px;" />
            <Label text="UCI" prefWidth="140" style="-fx-text-fill: #374151;" />
            <Label text="15 estudiantes" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="15/18" style="-fx-text-fill: #F59E0B; -fx-font-weight: bold; -fx-font-size: 12px;" />
          </HBox>
          <!-- Medicina Interna -->
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="●" style="-fx-text-fill: #6366F1; -fx-font-size: 14px;" />
            <Label text="Medicina Interna" prefWidth="140" style="-fx-text-fill: #374151;" />
            <Label text="16 estudiantes" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="16/20" style="-fx-text-fill: #6366F1; -fx-font-weight: bold; -fx-font-size: 12px;" />
          </HBox>
          <!-- Cirugia -->
          <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="●" style="-fx-text-fill: #10B981; -fx-font-size: 14px;" />
            <Label text="Cirugia" prefWidth="140" style="-fx-text-fill: #374151;" />
            <Label text="12 estudiantes" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="12/15" style="-fx-text-fill: #10B981; -fx-font-weight: bold; -fx-font-size: 12px;" />
          </HBox>

          <!-- Separador -->
          <Region prefHeight="4" />

          <!-- Gráfica compacta -->
          <LineChart fx:id="graficaServicios"  prefHeight="160.0" prefWidth="320.0"
          animated="false" legendVisible="false"
          style="-fx-background-color: transparent; -fx-padding: 0;">
          <xAxis>
          <CategoryAxis style="-fx-tick-label-font-size: 10px;" />
          </xAxis>
          <yAxis>
          <NumberAxis lowerBound="0" upperBound="25" tickUnit="5"
          style="-fx-tick-label-font-size: 10px;" />
          </yAxis>
       </LineChart>

        </VBox>

        <!-- Alertas recientes -->
        <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="12"
              style="-fx-background-color: white; -fx-background-radius: 14;
                     -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
          <HBox alignment="CENTER_LEFT">
            <Label text="Alertas recientes"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Ver todas"
                   style="-fx-text-fill: #1F8A8A; -fx-font-size: 12px; -fx-cursor: hand;" />
          </HBox>

          <!-- Alerta 1 -->
          <VBox spacing="3"
                style="-fx-background-color: #FEF2F2; -fx-background-radius: 10; -fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="6">
              <Label text="🔴" style="-fx-font-size: 12px;" />
              <Label text="Juan Perez — Fuera de horario"
                     style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #991B1B;" />
            </HBox>
            <Label text="Urgencias · 08:15"
                   style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" />
          </VBox>

          <!-- Alerta 2 -->
          <VBox spacing="3"
                style="-fx-background-color: #FFFBEB; -fx-background-radius: 10; -fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="6">
              <Label text="🟡" style="-fx-font-size: 12px;" />
              <Label text="Maria Gomez — Sin docente asignado"
                     style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #92400E;" />
            </HBox>
            <Label text="Pediatria · 08:10"
                   style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" />
          </VBox>

          <!-- Alerta 3 -->
          <VBox spacing="3"
                style="-fx-background-color: #FFFBEB; -fx-background-radius: 10; -fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="6">
              <Label text="🟡" style="-fx-font-size: 12px;" />
              <Label text="Pedro Ramos — Sin induccion completada"
                     style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #92400E;" wrapText="true"/>
            </HBox>
            <Label text="UCI · 07:50"
                   style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" />
          </VBox>

          <!-- Alerta 4 -->
          <VBox spacing="3"
                style="-fx-background-color: #FEF2F2; -fx-background-radius: 10; -fx-padding: 12;">
            <HBox alignment="CENTER_LEFT" spacing="6">
              <Label text="🔴" style="-fx-font-size: 12px;" />
              <Label text="Ana Torres — Documento ARL vencido"
                     style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #991B1B;" wrapText="true"/>
            </HBox>
            <Label text="Cirugia · 07:30"
                   style="-fx-font-size: 11px; -fx-text-fill: #6B7280;" />
          </VBox>

        </VBox>
      </GridPane>

      <!-- FILA 3: Validaciones antes de ingresar -->
      <VBox spacing="12"
            style="-fx-background-color: white; -fx-background-radius: 14;
                   -fx-border-color: #E5E7EB; -fx-border-radius: 14; -fx-padding: 20;
                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
        <Label text="Validaciones requeridas antes de ingresar"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <HBox spacing="12" alignment="CENTER_LEFT">

          <VBox spacing="6" prefWidth="175"
                style="-fx-background-color: #ECFDF5; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="✅ Induccion realizada"
                   style="-fx-font-weight: bold; -fx-text-fill: #065F46; -fx-font-size: 13px;" />
            <Label text="El estudiante debe haber completado induccion hospitalaria."
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
          </VBox>

          <VBox spacing="6" prefWidth="175"
                style="-fx-background-color: #ECFDF5; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="✅ ARL y seguro vigentes"
                   style="-fx-font-weight: bold; -fx-text-fill: #065F46; -fx-font-size: 13px;" />
            <Label text="Documentos de seguridad y ARL deben estar al dia."
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
          </VBox>

          <VBox spacing="6" prefWidth="175"
                style="-fx-background-color: #FFFBEB; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="⚠️ Docente ya ingreso"
                   style="-fx-font-weight: bold; -fx-text-fill: #92400E; -fx-font-size: 13px;" />
            <Label text="El docente responsable debe ingresar antes que sus estudiantes."
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
          </VBox>

          <VBox spacing="6" prefWidth="175"
                style="-fx-background-color: #FFFBEB; -fx-background-radius: 10; -fx-padding: 14;">
            <Label text="⚠️ Franja horaria activa"
                   style="-fx-font-weight: bold; -fx-text-fill: #92400E; -fx-font-size: 13px;" />
            <Label text="El ingreso solo se permite en la franja del cronograma mensual."
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #374151;" />
          </VBox>

        </HBox>
      </VBox>

</VBox>
</content>
</ScrollPane>